# Copy to `.env` and adjust. Every value is optional — leave a key blank or
# delete it and the built-in default in javdbClient.ts applies.

# Port published on the host. The container always listens on 5000.
HOST_PORT=5000

# ---------------------------------------------------------------------------
# Browser identity
#
# Cloudflare binds cf_clearance to (exit IP, User-Agent string, TLS/HTTP2
# fingerprint). The caller supplies the cookie; these three describe the browser
# that cookie came from. If they drift apart, Cloudflare invalidates the cookie
# on first use and every lookup returns 401 cloudflare_clearance_required.
#
# After a browser upgrade, re-read `navigator.userAgent` in DevTools and update
# JAVDB_UA and JAVDB_SEC_CH_UA together.
# ---------------------------------------------------------------------------
JAVDB_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36 Edg/152.0.0.0
JAVDB_SEC_CH_UA="Not:A-Brand";v="99", "Microsoft Edge";v="152", "Chromium";v="152"
JAVDB_SEC_CH_UA_PLATFORM="Windows"
JAVDB_ACCEPT_LANGUAGE=en-NZ,en;q=0.9,zh-CN;q=0.8,zh;q=0.7,en-US;q=0.6

# curl-impersonate TLS profile. Run `curl-impersonate --help` or check the
# upstream release for the available list; bump this if Cloudflare starts
# rejecting the current fingerprint.
CURL_IMPERSONATE_TARGET=chrome146
CURL_IMPERSONATE_VERSION=v2.0.0

# Per-request upstream timeout, milliseconds. Clamped to a 1000 ms floor: a zero
# here would otherwise disable every deadline the service has.
JAVDB_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Pacing
#
# Requests to javdb are serialised and spaced out by the service, not by its
# callers. The scarce resource is the clearance cookie, not CPU: two clients
# scraping at once look like a bot and get the cookie burned for everyone. One
# lookup costs two upstream requests -- a search and a detail page -- and both
# are paced.
# ---------------------------------------------------------------------------

# Smallest gap between two requests to javdb.
JAVDB_MIN_INTERVAL_MS=2000

# Lookups allowed to be waiting at once. Past this the service answers 429
# rather than queueing work that will age out anyway.
JAVDB_MAX_IN_FLIGHT=4

# ---------------------------------------------------------------------------
# Address family: "4", "6" or "auto".
#
# This is the subtlest way for a cookie to fail. Cloudflare binds cf_clearance
# to the client address, and one machine's IPv4 and IPv6 are different
# addresses. javdb.com publishes AAAA records, so a dual-stack browser reaches
# it over IPv6 and the cookie is bound there — while a Docker container has no
# IPv6 by default, silently falls back to IPv4, and gets challenged even though
# the TLS fingerprint, User-Agent and NAT address all match.
#
# Measured against javdb: the IPv6 binding is on the /64 prefix, not the exact
# address. A cookie minted by a browser at 2407:xxxx:xxxx:4400:7085::/64 worked
# from a server at 2407:xxxx:xxxx:4400:be24::/64 — same prefix, different host
# bits. So a separate box on the same LAN can use the browser's cookie, as long
# as it reaches javdb over IPv6. docker-compose.yml enables that.
#
# Pin this to "6" rather than leaving it "auto": a container holding only a ULA
# address can, under RFC 6724 address selection, prefer IPv4 for a global IPv6
# destination — reintroducing the silent fallback. "6" fails loudly instead.
#
# Set "4" only if this host has no IPv6. The cookie must then be minted over
# IPv4 as well, and browser and host must share one NAT address. To force a
# Windows browser onto IPv4 (reversible, undo with `netsh interface ipv6 reset`):
#   netsh interface ipv6 set prefixpolicy ::ffff:0:0/96 60 4
#
# BEFORE enabling the IPv6 network in docker-compose.yml, check the host. Docker
# turns on IPv6 forwarding to do it, and with the distro default accept_ra=1 a
# forwarding host ignores Router Advertisements -- so a host that gets its own
# global IPv6 by SLAAC loses its default route immediately and its address when
# the lifetime lapses. Put this in /etc/sysctl.d/99-docker-ipv6-ra.conf and run
# `sysctl --system` first:
#     net.ipv6.conf.all.accept_ra = 2
#     net.ipv6.conf.<uplink>.accept_ra = 2
#
# The 401 detail string always reports which family a request actually used.
JAVDB_IP_VERSION=6

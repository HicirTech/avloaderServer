{
  "name": "avloader-server",
  "version": "1.0.0",
  "description": "Looks up movie metadata on javdb from behind Cloudflare and returns it as JSON",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f avloader",
    "docker:rebuild": "docker compose build --no-cache && docker compose up -d --force-recreate",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "node-html-parser": "^6.1.12"
  }
}
